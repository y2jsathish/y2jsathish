@model VendorEditDto
@{
    var isEdit = Model.Id > 0;
}
<div class="modal-header">
    <h5 class="modal-title">@(isEdit ? "Edit Vendor" : "Add Vendor")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form id="vendorForm" asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="Vendor">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="VendorCode" class="form-label">Vendor Code</label>
            <input asp-for="VendorCode" class="form-control" />
            <span asp-validation-for="VendorCode" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="VendorName" class="form-label">Vendor Name</label>
            <input asp-for="VendorName" class="form-control" />
            <span asp-validation-for="VendorName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ContactPerson" class="form-label">Contact Person</label>
            <input asp-for="ContactPerson" class="form-control" />
        </div>
        <div class="row g-3">
            <div class="col-6">
                <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                <input asp-for="ContactNumber" class="form-control" />
            </div>
            <div class="col-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>
        </div>
        <div class="mb-3 mt-3">
            <label asp-for="ServiceRegionId" class="form-label">Service Region</label>
            <select asp-for="ServiceRegionId" class="form-select" asp-items="ViewBag.Regions"><option value="">-- Select --</option></select>
        </div>
        @if (isEdit)
        {
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

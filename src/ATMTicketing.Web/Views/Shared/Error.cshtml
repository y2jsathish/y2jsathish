@{
    ViewData["Title"] = "Error";
}
<div class="container py-5 text-center">
    <h1 class="display-5 text-danger"><i class="bi bi-exclamation-triangle"></i> An error occurred</h1>
    <p class="text-muted">Please try again, or contact your system administrator if the problem persists.</p>
    <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Back to Dashboard</a>
</div>

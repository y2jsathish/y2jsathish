@using Microsoft.AspNetCore.Identity
@using ATMTicketing.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ATM Call Log &amp; Ticket Management System</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.11/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    <div class="app-shell">
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-bank2"></i>
                <span>ATM Ticketing</span>
            </div>
            <ul class="nav flex-column sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                </li>
                @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.CallCenterAgent) || User.IsInRole(Roles.TeamLead) || User.IsInRole(Roles.OperationsManager))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Atm" asp-action="Index"><i class="bi bi-cash-stack"></i> ATM Master</a>
                    </li>
                }
                @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.TeamLead) || User.IsInRole(Roles.OperationsManager))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Vendor" asp-action="Index"><i class="bi bi-truck"></i> Vendor Master</a>
                    </li>
                }
                @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.CallCenterAgent) || User.IsInRole(Roles.TeamLead))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Ticket" asp-action="Create"><i class="bi bi-plus-circle"></i> New Ticket</a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Ticket" asp-action="Index"><i class="bi bi-ticket-detailed"></i> Tickets</a>
                </li>
                @if (User.IsInRole(Roles.FieldEngineer) || User.IsInRole(Roles.Administrator))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Engineer" asp-action="Workbench"><i class="bi bi-tools"></i> My Workbench</a>
                    </li>
                }
                @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.TeamLead))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="TicketAssignment" asp-action="Index"><i class="bi bi-diagram-3"></i> Assignment Board</a>
                    </li>
                }
                @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.OperationsManager) || User.IsInRole(Roles.TeamLead))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Sla" asp-action="Index"><i class="bi bi-stopwatch"></i> SLA Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Reports</a>
                    </li>
                }
                @if (User.IsInRole(Roles.Administrator))
                {
                    <li class="nav-item sidebar-section">Administration</li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Index"><i class="bi bi-people"></i> Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Sla" asp-action="Configuration"><i class="bi bi-sliders"></i> SLA Configuration</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="main-content">
            <header class="topbar">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle"><i class="bi bi-list"></i></button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-actions">
                    <button class="btn btn-sm btn-outline-secondary" id="darkModeToggle" title="Toggle dark mode">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary position-relative" data-bs-toggle="dropdown" id="notificationBell">
                            <i class="bi bi-bell"></i>
                            <span class="badge rounded-pill bg-danger d-none" id="notificationCount">0</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width: 320px;" id="notificationList">
                            <li class="text-muted small px-2">No new notifications</li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key"></i> Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="page-content">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.11/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.11/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

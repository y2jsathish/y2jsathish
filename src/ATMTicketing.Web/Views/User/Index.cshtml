@model IReadOnlyList<UserListItemDto>
@{
    ViewData["Title"] = "User Administration";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">User Administration</h5>
    <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-person-plus"></i> Add User</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover table-sm">
            <thead><tr><th>Name</th><th>Email</th><th>Employee Code</th><th>Region</th><th>Role(s)</th><th>Status</th><th>Last Login</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@(u.EmployeeCode ?? "-")</td>
                    <td>@(u.RegionName ?? "-")</td>
                    <td>@string.Join(", ", u.Roles)</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@(u.LastLoginDate?.ToString("g") ?? "Never")</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id"><i class="bi bi-pencil"></i></a>
                        <button class="btn btn-sm btn-outline-secondary btn-toggle" data-id="@u.Id">
                            <i class="bi @(u.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-warning btn-reset" data-id="@u.Id"><i class="bi bi-key"></i></button>
                        <button class="btn btn-sm btn-outline-danger btn-delete" data-id="@u.Id"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    $(".btn-toggle").on("click", function () {
        var id = $(this).data("id");
        $.post("/User/ToggleActive", { id: id }, function (result) {
            atmTicketing.showResult(result);
            if (result.succeeded) location.reload();
        });
    });
    $(".btn-reset").on("click", function () {
        if (!confirm("Generate a temporary password for this user?")) return;
        var id = $(this).data("id");
        $.post("/User/ResetPassword", { id: id }, function (result) {
            if (result.succeeded) {
                alert("Temporary password: " + result.data);
            } else {
                atmTicketing.showResult(result);
            }
        });
    });
    $(".btn-delete").on("click", function () {
        if (!confirm("Permanently delete this user? This only succeeds if they have no ticket history.")) return;
        var id = $(this).data("id");
        $.post("/User/Delete", { id: id }, function (result) {
            atmTicketing.showResult(result);
            if (result.succeeded) location.reload();
        });
    });
});
</script>
}

@model IReadOnlyList<CategoryListItemDto>
@{
    ViewData["Title"] = "Category Master";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Category Master</h5>
    <button class="btn btn-primary btn-sm" id="btnAddCategory"><i class="bi bi-plus-circle"></i> Add Category</button>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover table-sm" id="categoryTable">
            <thead><tr><th>Name</th><th>Description</th><th>Tickets</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@(c.Description ?? "-")</td>
                    <td>@c.TicketCount</td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <button class="btn btn-sm btn-outline-primary btn-edit" data-id="@c.Id"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger btn-delete" data-id="@c.Id"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No categories yet.</p>
        }
    </div>
</div>

<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="categoryModalContent"></div>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    function openModal(url) {
        $.get(url, function (html) {
            $("#categoryModalContent").html(html);
            $("#categoryModal").modal("show");
        });
    }

    $("#btnAddCategory").on("click", function () { openModal("/Category/Create"); });
    $("#categoryTable").on("click", ".btn-edit", function () { openModal("/Category/Edit/" + $(this).data("id")); });

    $("#categoryTable").on("click", ".btn-delete", function () {
        if (!confirm("Delete this category?")) return;
        $.post("/Category/Delete", { id: $(this).data("id") }, function (result) {
            atmTicketing.showResult(result);
            if (result.succeeded) location.reload();
        });
    });

    $(document).on("submit", "#categoryForm", function (e) {
        e.preventDefault();
        var form = $(this);
        $.post(form.attr("action"), form.serialize(), function (result) {
            atmTicketing.showResult(result);
            if (result.succeeded) {
                $("#categoryModal").modal("hide");
                location.reload();
            }
        });
    });
});
</script>
}

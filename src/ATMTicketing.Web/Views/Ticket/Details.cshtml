@model TicketDetailsDto
@{
    ViewData["Title"] = $"Ticket {Model.TicketNumber}";
    var statuses = ViewBag.Statuses as IReadOnlyList<ATMTicketing.Domain.Entities.StatusMaster>;
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-1">@Model.TicketNumber <span class="status-badge" style="background:@Model.StatusColor">@Model.Status</span></h5>
        <div class="text-muted small">
            <span class="priority-@Model.Priority">@Model.Priority Priority</span> &middot; Created @Model.CreatedDate.ToLocalTime().ToString("g") by @Model.CreatedByName
            @if (Model.IsEscalated)
            {
                <span class="badge bg-danger ms-2">Escalated</span>
            }
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to list</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Incident Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">ATM</dt><dd class="col-sm-9">@Model.AtmCode — @Model.AtmName<br /><span class="text-muted small">@Model.AtmAddress</span></dd>
                    <dt class="col-sm-3">Incident Type</dt><dd class="col-sm-9">@Model.IncidentType</dd>
                    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category @(string.IsNullOrEmpty(Model.SubCategory) ? "" : $"/ {Model.SubCategory}")</dd>
                    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
                    <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.ContactPerson (@Model.ContactNumber)</dd>
                    <dt class="col-sm-3">Assigned To</dt><dd class="col-sm-9">@(Model.AssignedToName ?? "Unassigned")</dd>
                    <dt class="col-sm-3">Vendor</dt><dd class="col-sm-9">@(Model.VendorName ?? "-")</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Timeline</div>
            <div class="card-body">
                <div class="ticket-timeline">
                    @foreach (var h in Model.History)
                    {
                        <div class="timeline-item">
                            <div class="fw-semibold small">@h.ActionType @(h.OldValue != null || h.NewValue != null ? $"({h.OldValue} → {h.NewValue})" : "")</div>
                            @if (!string.IsNullOrEmpty(h.Notes))
                            {
                                <div class="small">@h.Notes</div>
                            }
                            <div class="text-muted small">@h.ActionByName &middot; @h.ActionDate.ToLocalTime().ToString("g")</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Attachments</div>
            <div class="card-body">
                <ul class="list-group mb-3">
                    @foreach (var a in Model.Attachments)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="@a.Url" target="_blank"><i class="bi bi-paperclip"></i> @a.FileName</a>
                            <span class="text-muted small">@a.UploadedByName &middot; @a.UploadedDate.ToLocalTime().ToString("g")</span>
                        </li>
                    }
                    @if (!Model.Attachments.Any())
                    {
                        <li class="list-group-item text-muted small">No attachments yet.</li>
                    }
                </ul>
                @if (User.IsInRole(Roles.FieldEngineer) || User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.TeamLead))
                {
                    <form id="attachmentForm" enctype="multipart/form-data" class="d-flex gap-2">
                        <input type="file" name="file" class="form-control form-control-sm" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-upload"></i> Upload</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">SLA</div>
            <div class="card-body small">
                <div class="mb-2"><strong>Response due:</strong> @(Model.ResponseDueAt?.ToLocalTime().ToString("g") ?? "-")</div>
                <div class="mb-2"><strong>Resolution due:</strong> @(Model.ResolutionDueAt?.ToLocalTime().ToString("g") ?? "-")</div>
                @if (Model.ResolutionDueAt.HasValue && !Model.ResolvedAt.HasValue)
                {
                    <div class="mb-2"><strong>Time remaining:</strong>
                        @if (Model.IsResolutionBreached)
                        {
                            <span class="sla-countdown breached">Breached</span>
                        }
                        else
                        {
                            <span class="sla-countdown" data-sla-due="@Model.ResolutionDueAt.Value.ToString("o")"></span>
                        }
                    </div>
                }
                <div class="mb-2"><strong>Resolved:</strong> @(Model.ResolvedAt?.ToLocalTime().ToString("g") ?? "-")</div>
                <div><strong>Closed:</strong> @(Model.ClosedAt?.ToLocalTime().ToString("g") ?? "-")</div>
            </div>
        </div>

        @if (User.IsInRole(Roles.FieldEngineer) || User.IsInRole(Roles.TeamLead) || User.IsInRole(Roles.Administrator))
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Update Status</div>
                <div class="card-body">
                    <form id="statusForm">
                        <input type="hidden" name="TicketId" value="@Model.Id" />
                        <select name="NewStatusId" class="form-select form-select-sm mb-2">
                            @if (statuses != null)
                            {
                                foreach (var s in statuses.OrderBy(s => s.SortOrder))
                                {
                                    if (s.Id == Model.StatusId)
                                    {
                                        <option value="@s.Id" selected>@s.DisplayName</option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id">@s.DisplayName</option>
                                    }
                                }
                            }
                        </select>
                        <textarea name="Notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Notes (optional)"></textarea>
                        <button type="submit" class="btn btn-sm btn-primary w-100">Update Status</button>
                    </form>
                </div>
            </div>
        }

        @if (User.IsInRole(Roles.TeamLead) || User.IsInRole(Roles.Administrator))
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Assign / Reassign</div>
                <div class="card-body">
                    <form id="assignForm">
                        <input type="hidden" name="TicketId" value="@Model.Id" />
                        <select name="EngineerId" class="form-select form-select-sm mb-2" id="engineerSelect"></select>
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Assign</button>
                    </form>
                    <hr />
                    <form id="escalateForm">
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <input type="text" name="reason" class="form-control form-control-sm mb-2" placeholder="Escalation reason" />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Escalate</button>
                    </form>
                </div>
            </div>
        }

        @if ((User.IsInRole(Roles.FieldEngineer) || User.IsInRole(Roles.Administrator)) && Model.ClosedAt is null)
        {
            <div class="card">
                <div class="card-header fw-semibold">Close Ticket</div>
                <div class="card-body">
                    <form id="closeForm">
                        <input type="hidden" name="TicketId" value="@Model.Id" />
                        <textarea name="ResolutionNotes" class="form-control form-control-sm mb-2" rows="2" placeholder="Resolution notes" required></textarea>
                        <textarea name="ClosureRemarks" class="form-control form-control-sm mb-2" rows="2" placeholder="Closure remarks" required></textarea>
                        <button type="submit" class="btn btn-sm btn-success w-100">Close Ticket</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
$(function () {
    function postJson(url, data, onDone) {
        $.post(url, data, function (result) {
            atmTicketing.showResult(result);
            if (result.succeeded) onDone();
        });
    }

    $("#statusForm").on("submit", function (e) {
        e.preventDefault();
        postJson("/Ticket/UpdateStatus", $(this).serialize(), function () { location.reload(); });
    });

    $("#escalateForm").on("submit", function (e) {
        e.preventDefault();
        postJson("/Ticket/Escalate", $(this).serialize(), function () { location.reload(); });
    });

    $("#closeForm").on("submit", function (e) {
        e.preventDefault();
        postJson("/Ticket/Close", $(this).serialize(), function () { location.reload(); });
    });

    $("#assignForm").on("submit", function (e) {
        e.preventDefault();
        postJson("/Ticket/Assign", $(this).serialize(), function () { location.reload(); });
    });

    var engineerSelect = $("#engineerSelect");
    if (engineerSelect.length) {
        fetch("/api/dashboard/engineer-workload").then(r => r.json()).then(function (rows) {
            rows.forEach(function (r) {
                engineerSelect.append('<option value="' + r.engineerId + '">' + r.engineerName + ' (' + r.openTickets + ' open)</option>');
            });
        });
    }

    $("#attachmentForm").on("submit", function (e) {
        e.preventDefault();
        var formData = new FormData(this);
        formData.append("ticketId", "@Model.Id");
        $.ajax({
            url: "/Ticket/UploadAttachment", type: "POST", data: formData, processData: false, contentType: false,
            success: function (result) {
                atmTicketing.showResult(result);
                if (result.succeeded) location.reload();
            }
        });
    });
});
</script>
}

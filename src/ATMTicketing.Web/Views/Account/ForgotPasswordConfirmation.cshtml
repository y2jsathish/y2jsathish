@{
    ViewData["Title"] = "Check your email";
}
<div class="auth-page">
    <div class="auth-card text-center">
        <i class="bi bi-envelope-check text-success" style="font-size: 2.5rem;"></i>
        <h4 class="fw-bold mt-2">Check your email</h4>
        <p class="text-muted small">If an account exists for that email address, a password reset link has been sent.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Back to login</a>
    </div>
</div>

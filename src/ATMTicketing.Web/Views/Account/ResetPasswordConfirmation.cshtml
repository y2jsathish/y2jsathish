@{
    ViewData["Title"] = "Password Reset";
}
<div class="auth-page">
    <div class="auth-card text-center">
        <i class="bi bi-shield-check text-success" style="font-size: 2.5rem;"></i>
        <h4 class="fw-bold mt-2">Password updated</h4>
        <p class="text-muted small">You can now sign in with your new password.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Sign in</a>
    </div>
</div>

@model ATMTicketing.Web.Controllers.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="auth-page">
    <div class="auth-card">
        <h4 class="fw-bold mb-1">Forgot your password?</h4>
        <p class="text-muted small mb-4">Enter your account email and we'll send you a reset link.</p>
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            <div class="text-center mt-3">
                <a asp-controller="Account" asp-action="Login" class="small">Back to login</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

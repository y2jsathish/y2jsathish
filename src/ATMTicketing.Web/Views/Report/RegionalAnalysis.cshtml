@model IReadOnlyList<RegionalAnalysisReportRow>
@{
    ViewData["Title"] = "Regional Analysis Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Regional Analysis Report</h5>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="@Url.Action("ExportRegionalAnalysis", new { format = "excel" })"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="@Url.Action("ExportRegionalAnalysis", new { format = "pdf" })"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <table class="table table-sm table-striped">
            <thead><tr><th>Region</th><th>Total Tickets</th><th>Open Tickets</th><th>SLA Breaches</th><th>ATM Count</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Region</td><td>@r.TotalTickets</td><td>@r.OpenTickets</td><td>@r.Breaches</td><td>@r.AtmCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

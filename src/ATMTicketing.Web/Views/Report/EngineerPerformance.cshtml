@model IReadOnlyList<EngineerPerformanceReportRow>
@{
    ViewData["Title"] = "Engineer Performance Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Engineer Performance Report</h5>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="@Url.Action("ExportEngineerPerformance", new { format = "excel" })"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="@Url.Action("ExportEngineerPerformance", new { format = "pdf" })"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <table class="table table-sm table-striped">
            <thead><tr><th>Engineer</th><th>Assigned</th><th>Resolved</th><th>Avg. Resolution (hrs)</th><th>SLA Breaches</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.EngineerName</td><td>@r.TotalAssigned</td><td>@r.Resolved</td>
                    <td>@r.AvgResolutionHours.ToString("0.0")</td><td>@r.SlaBreaches</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

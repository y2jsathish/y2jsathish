@model IReadOnlyList<AtmUptimeReportRow>
@{
    ViewData["Title"] = "ATM Uptime Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">ATM Uptime / Downtime Report</h5>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="@Url.Action("ExportAtmUptime", new { format = "excel" })"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="@Url.Action("ExportAtmUptime", new { format = "pdf" })"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <table class="table table-sm table-striped">
            <thead><tr><th>ATM</th><th>Name</th><th>Region</th><th>Down Count</th><th>Downtime (hrs)</th><th>Uptime %</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr class="@(r.UptimePercent < 95 ? "table-danger" : "")">
                    <td>@r.AtmCode</td><td>@r.AtmName</td><td>@r.Region</td>
                    <td>@r.DownCount</td><td>@r.TotalDowntimeHours.ToString("0.0")</td><td>@r.UptimePercent.ToString("0.00")%</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

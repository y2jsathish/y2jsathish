@model IReadOnlyList<TicketSummaryReportRow>
@{
    ViewData["Title"] = "Ticket Summary Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Ticket Summary Report</h5>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="@Url.Action("ExportTicketSummary", new { format = "excel" })"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="@Url.Action("ExportTicketSummary", new { format = "pdf" })"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <table class="table table-sm table-striped">
            <thead><tr><th>Ticket #</th><th>ATM</th><th>Category</th><th>Priority</th><th>Status</th><th>Region</th><th>Assigned To</th><th>Created</th><th>Closed</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.TicketNumber</td><td>@r.AtmCode</td><td>@r.Category</td>
                    <td><span class="priority-@r.Priority">@r.Priority</span></td><td>@r.Status</td><td>@r.Region</td>
                    <td>@(r.AssignedTo ?? "-")</td><td>@r.CreatedDate.ToString("g")</td><td>@(r.ClosedAt?.ToString("g") ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

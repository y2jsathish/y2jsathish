@model AtmEditDto
@{
    var isEdit = Model.Id > 0;
}
<div class="modal-header">
    <h5 class="modal-title">@(isEdit ? "Edit ATM" : "Add ATM")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form id="atmForm" asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="Atm">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="AtmCode" class="form-label">ATM Code</label>
                <input asp-for="AtmCode" class="form-control" />
                <span asp-validation-for="AtmCode" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AtmName" class="form-label">ATM Name</label>
                <input asp-for="AtmName" class="form-control" />
                <span asp-validation-for="AtmName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BankName" class="form-label">Bank Name</label>
                <input asp-for="BankName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="RegionId" class="form-label">Region</label>
                <select asp-for="RegionId" class="form-select" asp-items="ViewBag.Regions"><option value="">-- Select --</option></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Zone" class="form-label">Zone</label>
                <input asp-for="Zone" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="State" class="form-label">State</label>
                <input asp-for="State" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="City" class="form-label">City</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="VendorId" class="form-label">Vendor</label>
                <select asp-for="VendorId" class="form-select" asp-items="ViewBag.Vendors"><option value="">-- Select --</option></select>
            </div>
            <div class="col-12">
                <label asp-for="Address" class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="AtmType" class="form-label">ATM Type</label>
                <select asp-for="AtmType" class="form-select" asp-items="Html.GetEnumSelectList<ATMTicketing.Domain.Enums.AtmType>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ATMTicketing.Domain.Enums.AtmOperationalStatus>()"></select>
            </div>
            <div class="col-md-2">
                <label asp-for="Latitude" class="form-label">Latitude</label>
                <input asp-for="Latitude" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Longitude" class="form-label">Longitude</label>
                <input asp-for="Longitude" class="form-control" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

@model RegionEditDto
@{
    var isEdit = Model.Id > 0;
}
<div class="modal-header">
    <h5 class="modal-title">@(isEdit ? "Edit Region" : "Add Region")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form id="regionForm" asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="Region">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="RegionName" class="form-label">Region Name</label>
            <input asp-for="RegionName" class="form-control" />
            <span asp-validation-for="RegionName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Zone" class="form-label">Zone</label>
            <input asp-for="Zone" class="form-control" />
            <span asp-validation-for="Zone" class="text-danger small"></span>
        </div>
        @if (isEdit)
        {
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
